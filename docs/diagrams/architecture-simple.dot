digraph architecture {
    rankdir=LR;
    bgcolor=white;
    pad=0.4;
    nodesep=0.7;
    ranksep=1.0;
    splines=spline;
    fontname="Helvetica";

    node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=18,
          margin="0.25,0.18", color="#37474F", fontcolor="#212121",
          fillcolor="#ECEFF1", penwidth=1.4];
    edge [color="#455A64", fontname="Helvetica", fontsize=17, arrowsize=0.9,
          penwidth=1.3, fontcolor="#1A237E"];

    User     [shape=ellipse, label="User CLI",
              fillcolor="#CFD8DC", color="#37474F"];
    Police   [label=<<B>Policeman Agent</B>>,
              fillcolor="#BBDEFB", color="#1565C0", fontcolor="#0D47A1"];
    Defense  [label=<<B>6-Layer Defense Pipeline</B>>,
              fillcolor="#B2DFDB", color="#00695C", fontcolor="#004D40"];
    Chatbot  [label=<<B>Chatbot Agent</B>>,
              fillcolor="#C5E1A5", color="#558B2F", fontcolor="#33691E"];
    External [shape=cylinder, label=<<B>External Services</B>>,
              fillcolor="#FFE0B2", color="#E65100", fontcolor="#BF360C"];
    Log      [shape=note, label=<<B>Audit Log</B>>,
              fillcolor="#E1BEE7", color="#6A1B9A", fontcolor="#4A148C"];
    LTM      [shape=folder, label=<<B>Long-Term Memory</B>>,
              fillcolor="#D1C4E9", color="#4527A0", fontcolor="#311B92"];

    User    -> Police   [dir=both, label="input / output"];
    Police  -> Defense  [label="validate"];
    Police  -> Chatbot  [label="dispatch"];
    Defense -> External [style=dashed];
    Chatbot -> External [style=dashed];
    Police  -> Log      [style=dashed, label="audit"];
    Police  -> LTM      [style=dashed, label="on block"];
    LTM     -> External [style=dashed];
}
